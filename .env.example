# Optional template. npm run setup creates .env.local and generates missing secrets.
# Use HTTPS + PostgreSQL for an internet-facing deployment.
APP_URL=http://localhost:3000
DATABASE_URL=
# Local SQLite only; production additionally requires ALLOW_LOCAL_DB=1 to opt in.
SQLITE_PATH=.local/autoraum.sqlite
ALLOW_LOCAL_DB=1
# Account-free public adapters are enabled on new installations. Set 0 to disable.
# Operators remain responsible for applicable source terms and data permissions.
PUBLIC_MARKETPLACE_SEARCH=1
# Disable optional Next.js telemetry for this installation.
NEXT_TELEMETRY_DISABLED=1
# Optional dedicated project Search API credentials, server-side only.
# Enable shared access only if the provider contract covers all client businesses.
MOBILE_API_USERNAME=
MOBILE_API_PASSWORD=
# npm run setup generates these. Never commit the generated .env.local.
DATA_ENCRYPTION_KEY=
CRON_SECRET=
