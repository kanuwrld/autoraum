{
  "name": "autoraum",
  "version": "0.1.0",
  "description": "Multi-tenant vehicle sourcing workspace for German dealerships",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "privacy:check": "tsx scripts/check-public-files.ts",
    "test:e2e": "python3 tests/e2e.py",
    "test:postgres": "python3 tests/postgres.py",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "backup": "tsx --env-file=.env.local scripts/backup.ts",
    "local:service": "tsx --env-file=.env.local scripts/local-service.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.7"
    }
  }
}
